# Адрес сайта без слэша в конце (нужен для входа через Steam и ссылок в уведомлениях)
SITE_URL=https://luxedrop.gg

# Postgres (Neon). Проставляется сам при подключении Neon в Vercel → Storage
DATABASE_URL=

# Подпись cookie сессии — длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ключ шифрования номеров карт, 64 hex-символа (та же команда). Без него вывод на карту выключен
DATA_KEY=

# Crypto Pay: @CryptoBot → Crypto Pay → Create App → API token. Вебхук: https://<сайт>/api/webhooks/cryptopay
CRYPTOPAY_TOKEN=
# 1 — тестовая сеть (@CryptoTestnetBot)
CRYPTOPAY_TESTNET=0

# market.csgo.com — автоматическая выдача скинов. Без ключа выводы скинов идут админу вручную
MARKET_API_KEY=

# Бот LuxeDrop: Mini App апгрейдера + уведомления админу. ОТДЕЛЬНЫЙ бот, не SOVSIDE:
# при деплое у бота перенастраивается вебхук
TG_BOT_TOKEN=
# Имя бота без @ (для кнопки «Открыть в боте»). В BotFather: /setdomain → домен сайта (нужно для входа на сайте)
TG_BOT_USERNAME=
# id чата/группы для уведомлений админу
TG_ADMIN_CHAT_ID=
# Telegram ID админов через запятую (узнать свой — у @userinfobot)
ADMIN_TG_IDS=
# Или ники админов через запятую, без @ (надёжнее ID: ник можно сменить, а освободившийся — займёт другой)
ADMIN_TG_USERNAMES=

# Секрет для крона обновления цен (Vercel подставляет его сам в Authorization)
CRON_SECRET=

# Валюта цен Skinport. Если не RUB — укажите курс к рублю
PRICE_CURRENCY=RUB
USD_RUB_RATE=
PRICE_TTL_MINUTES=60

# Кнопка «+5 000 ₽ тестовых» в профиле. Только для стенда! В бою — 0
DEMO_TOPUP=0
