# Токен от @BotFather. Никогда не коммить настоящий токен в репозиторий.
BOT_TOKEN=

# Твой Telegram ID (узнать: напиши боту /id). Можно несколько через запятую.
ADMIN_ID=

# Публичный HTTPS-адрес, где открыт этот сервер (Mini App работает только по https).
# Пример: https://sovside.example.com
WEBAPP_URL=

# Порт HTTP-сервера
PORT=3000

# Ссылка на твой Telegram (канал или личка), показывается на главной.
# Пример: https://t.me/sovside
TELEGRAM_LINK=

# Сколько заказов ты уже сделал до бота. Прибавляется к выполненным в боте.
COMPLETED_ORDERS_BASE=0

# Папка для базы и картинок из чата
DATA_DIR=./data
