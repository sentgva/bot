# Токен от @BotFather. Никогда не коммить настоящий токен в репозиторий.
BOT_TOKEN=

# Telegram ID админов через запятую (узнать: напиши боту /id).
# Необязательно: первого админа можно назначить секретной ссылкой, её печатает npm start.
ADMIN_ID=

# Публичный HTTPS-адрес, где открыт этот сервер (Mini App работает только по https).
# Пример: https://sovside.example.com
WEBAPP_URL=

# Порт HTTP-сервера
PORT=3000

# Ссылка на твой Telegram (канал или личка), показывается на главной.
# Пример: https://t.me/sovside
TELEGRAM_LINK=

# Сколько заказов ты уже сделал до бота. Прибавляется к выполненным в боте.
COMPLETED_ORDERS_BASE=0

# Папка для базы и картинок из чата (если не задан DATABASE_URL)
DATA_DIR=./data

# Postgres (например, Neon). Без него данные хранятся в файле DATA_DIR/db.json
DATABASE_URL=

# Vercel Blob для фото из чата. Без него фото лежат в DATA_DIR/uploads
BLOB_READ_WRITE_TOKEN=
